# --- extracted game content -------------------------------------------------
# Never commit ripped assets. They belong in the on-disk cache outside the repo
# (%LOCALAPPDATA%/GammaToolkit/cache/), not in git history where they are
# permanent, bloat every clone, and are the part most likely to draw a takedown.
sprites/
audio/
extracted/
extracted-ea/
*.png
*.mp3
*.wav
*.ogg
*.uasset
*.uexp
*.ubulk
*.pak
*.utoc
*.ucas
index.json
audio.json
catalog.json

# the starter sprites ARE part of the app UI, not an extraction dump
!app/renderer/assets/
!app/renderer/assets/*.gif

# --- third-party binaries ---------------------------------------------------
# Oodle (Epic/RAD) and binkadec (RAD) are proprietary and not redistributed
# here. tools/README.md says where to get them and where to put them.
# Oodle and binkadec ARE committed: without them a portable build cannot read
# the pak or export a cry, and asking every user to go and find them defeats
# the point of a portable exe. They are small (1 MB / 32 MB).
# ffmpeg stays out -- 115 MB, and freely downloadable; tools/README.md says
# which build the release bundles and where it comes from.
tools/ffmpeg.exe
tools/ffmpeg-LICENSE.txt

# --- secrets / keys ---------------------------------------------------------
# The EA pak AES key is deliberately compiled into daemon/gamma/versions.py so
# the app decrypts with zero setup. Loose key files are still ignored so a
# machine-specific override never lands in a commit by accident.
*_aes.key
ea-AES.txt

# --- local reference material ------------------------------------------------
# Cheat scripts kept locally to learn from. Not part of the toolkit and not
# mine to publish.
cheatExamples/

# --- build artifacts --------------------------------------------------------
node_modules/
dist/
dist-daemon/
build/
build-daemon/
release/
_pack-*/
*.spec
# ...except the PyInstaller recipe for the portable daemon, which IS the build
!daemon.spec
__pycache__/
*.py[cod]
.venv/
venv/

# --- editor / os ------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
*.bak
*.scaffold.bak
*.log
